      "link": null,
      "locked": false,
      "text": "#if one or more functions are not defined in a class\n#  it is called abstract cvlass\n\nclass AB:\n    def sum(self):\n        pass\n    def div(self):\n        pass\nobj = AB()\nprint(obj.sum())",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#if one or more functions are not defined in a class\n#  it is called abstract cvlass\n\nclass AB:\n    def sum(self):\n        pass\n    def div(self):\n        pass\nobj = AB()\nprint(obj.sum())",
      "autoResize": true,
      "lineHeight": 1.25
    },
