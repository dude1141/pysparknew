      "updated": 1778887501657,
      "link": null,
      "locked": false,
      "text": "from abc import ABC, abstractmethod\n\nclass Greet():\n    @abstractmethod\n    def say_hello(self):\n        pass\n\nclass English(Greet):\n    def say_hello(self):\n        return \"Hello\"\n    \nobj1 = English()\nprint(obj1.say_hello())\n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from abc import ABC, abstractmethod\n\nclass Greet():\n    @abstractmethod\n    def say_hello(self):\n        pass\n\nclass English(Greet):\n    def say_hello(self):\n        return \"Hello\"\n    \nobj1 = English()\nprint(obj1.say_hello())\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
